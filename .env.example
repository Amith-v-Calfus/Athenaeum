# Used by docker-compose.yml, passed through to the worker and api services.
OPENAI_API_KEY=sk-...

# The values below are already set as defaults inside docker-compose.yml for
# the containerized services (redis://redis:6379/0, weaviate:8080, etc).
# They're listed here only for reference when running a service outside
# docker-compose (its own services/*/.env), where the defaults are localhost.
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=ingestion_jobs
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051
